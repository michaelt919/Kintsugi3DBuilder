<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>Kintsugi3D</groupId>
    <artifactId>Kintsugi3DBuilder</artifactId>
    <version>1.6.0</version>
    <packaging>jar</packaging>
    <build>
        <sourceDirectory>src</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>1.12</version>
                <executions>
                    <execution>
                        <id>timestamp-property</id>
                        <goals>
                            <goal>timestamp-property</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <name>current.year</name>
                            <pattern>yyyy</pattern>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                    <compilerArgs>
                        <arg>--add-exports</arg>
                        <arg>java.desktop/sun.java2d.cmm=ALL-UNNAMED</arg>
                    </compilerArgs>
                </configuration>
                <executions>
                    <execution>
                        <id>log4j-plugin-processor</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <phase>process-classes</phase>
                        <configuration>
                            <proc>only</proc>
                            <annotationProcessors>
                                <annotationProcessor>org.apache.logging.log4j.core.config.plugins.processor.PluginProcessor</annotationProcessor>
                            </annotationProcessors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <transformers>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                            <mainClass>kintsugi3d.builder.app.Kintsugi3DBuilder</mainClass>
                        </transformer>
                        <transformer implementation="com.github.edwgiz.mavenShadePlugin.log4j2CacheTransformer.PluginsCacheFileTransformer" />
                    </transformers>
                    <shadedArtifactAttached>true</shadedArtifactAttached>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.github.edwgiz</groupId>
                        <artifactId>maven-shade-plugin.log4j2-cachefile-transformer</artifactId>
                        <version>2.6.1</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>1.13.0</version>
                <executions>
                    <!-- Download JRE -->
                    <execution>
                        <id>download-jre</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>
                                https://api.adoptium.net/v3/binary/latest/${java.version}/ga/${jre.os}/${jre.arch}/jre/hotspot/normal/eclipse
                            </url>
                            <outputDirectory>
                                ${project.build.directory}
                            </outputDirectory>
                            <outputFileName>jre.tar.gz</outputFileName>
                        </configuration>
                    </execution>
                    <!-- Download latest published build of Kinsugi 3D Viewer -->
                    <execution>
                        <id>download-viewer</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>
                                https://github.com/UWStout/Kintsugi3DViewer/releases/download/v${viewer.version}/Kintsugi3DViewer-${viewer.os}.zip
                            </url>
                            <outputDirectory>
                                ${project.build.directory}
                            </outputDirectory>
                            <outputFileName>Kintsugi3DViewer.zip</outputFileName>
                        </configuration>
                    </execution>
                    <!-- Download latest published build of USDZ exporter -->
                    <!-- Put this one in bin rather than in target so that it's also accessible when running in IDE. -->
                    <execution>
                        <id>download-usdz-exporter</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>
                                https://github.com/PoctorDepper/usdz-exporter/releases/download/v${usdz-exporter.version}/usdz-exporter-v${usdz-exporter.version}-${usdz-exporter.os}
                            </url>
                            <outputDirectory>
                                ${project.basedir}/bin
                            </outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!-- Change permissions for USDZ exporter.  Should be no-op on Windows -->
                    <execution>
                        <id>chmod-usdz-exporter</id>
                        <phase>generate-resources</phase>
                        <configuration>
                            <target>
                                <chmod file="${project.basedir}/bin/usdz-exporter-v${usdz-exporter.version}-${usdz-exporter.os}"
                                       perm="755"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                    <!-- Unzip JRE - explicitly invoking tar so that we can use strip-components  -->
                    <execution>
                        <id>unpack-jre</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete dir="${project.build.directory}/jre"/>
                                <mkdir dir="${project.build.directory}/jre"/>
                                <exec executable="tar" failonerror="true">
                                    <arg value="-xzf"/>
                                    <arg value="${project.build.directory}/jre.tar.gz"/>
                                    <arg value="--strip-components=1"/>
                                    <arg value="-C"/>
                                    <arg value="${project.build.directory}/jre"/>
                                </exec>
                                <delete file="${project.build.directory}/jre.tar.gz"/>
                            </target>
                        </configuration>
                    </execution>
                    <!-- Unzip Kintsugi 3D Viewer -->
                    <execution>
                        <id>unpack-viewer</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <unzip
                                        src="${project.build.directory}/Kintsugi3DViewer.zip"
                                        dest="${project.build.directory}/viewer"
                                />
                                <chmod
                                        file="${project.build.directory}/viewer/Kintsugi 3D Viewer.app/Contents/MacOS/Kintsugi 3D Viewer"
                                        perm="755"
                                />
                                <delete file="${project.build.directory}/Kintsugi3DViewer.zip"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/kintsugi3d-builder-about.txt</include>
                    <include>**/Info.plist</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/kintsugi3d-builder-about.txt</exclude>
                    <exclude>**/Info.plist</exclude>
                </excludes>
            </resource>
        </resources>
    </build>
    <properties>
        <java.version>11</java.version>
        <lwjgl.version>3.3.3</lwjgl.version>
        <viewer.version>1.5.2</viewer.version>
        <usdz-exporter.version>1.2.2</usdz-exporter.version>
    </properties>
    <profiles>
        <profile>
            <id>lwjgl-natives-macos-x86_64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <properties>
                <lwjgl.natives>natives-macos</lwjgl.natives>
                <jre.os>mac</jre.os>
                <jre.arch>x64</jre.arch>
                <viewer.os>macos</viewer.os>
                <usdz-exporter.os>macos</usdz-exporter.os>
            </properties>
        </profile>
        <profile>
            <id>lwjgl-natives-macos-arm64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <lwjgl.natives>natives-macos-arm64</lwjgl.natives>
                <jre.os>mac</jre.os>
                <jre.arch>aarch64</jre.arch>
                <viewer.os>macos</viewer.os>
                <usdz-exporter.os>macos</usdz-exporter.os>
            </properties>
        </profile>
        <profile>
            <id>macos-install</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <build>
                <!-- MacOS: Needs a Maven assembly for MacOS and then the disk image script -->
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>build-dist-macos</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <descriptors>
                                        <descriptor>src/assembly/distribution-macos.xml</descriptor>
                                    </descriptors>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!-- Disk image for MacOS -->
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>create-dmg</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/macos-disk-image.sh</argument>
                                        <argument>Kintsugi 3D Builder ${project.version}</argument>
                                        <argument>${project.build.directory}</argument>
                                        <argument>${project.build.directory}/${project.artifactId}-${project.version}-distribution-macos.zip</argument>
                                        <argument>${project.build.directory}/${project.artifactId}-${project.version}</argument>
                                        <argument>${project.build.directory}/${project.artifactId}-${project.version}-macos.dmg</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>windows-amd64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <lwjgl.natives>natives-windows</lwjgl.natives>
                <jre.os>windows</jre.os>
                <jre.arch>x64</jre.arch>
                <viewer.os>windows</viewer.os>
                <usdz-exporter.os>windows.exe</usdz-exporter.os>
            </properties>
            <build>
                <!-- Windows: Needs Launch4J, a Maven assembly for Windows, and NSIS installer -->
                <plugins>
                    <plugin>
                        <groupId>com.akathist.maven.plugins.launch4j</groupId>
                        <artifactId>launch4j-maven-plugin</artifactId>
                        <version>2.1.2</version>
                        <executions>
                            <execution>
                                <id>l4j-clui</id>
                                <phase>package</phase>
                                <goals><goal>launch4j</goal></goals>
                                <configuration>
                                    <headerType>gui</headerType>
                                    <outfile>${project.build.directory}/Kintsugi3DBuilder.exe</outfile>
                                    <jar>${project.build.directory}/${project.artifactId}-${project.version}-shaded.jar</jar>
                                    <icon>Kintsugi3D.ico</icon>
                                    <downloadUrl>https://adoptium.net/temurin/releases/?version=11</downloadUrl>
                                    <chdir>.</chdir>
                                    <jre>
                                        <path>jre;%JAVA_HOME%;%PATH%</path>
                                        <minVersion>11.0.0</minVersion>
                                        <maxVersion>11.99.99</maxVersion>
                                    </jre>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>build-dist-zip</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <descriptors>
                                        <descriptor>src/assembly/distribution.xml</descriptor>
                                    </descriptors>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.digitalmediaserver</groupId>
                        <artifactId>nsis-maven-plugin</artifactId>
                        <version>1.0.3</version>
                        <configuration>
                            <injectHeaderFile>true</injectHeaderFile>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-windows-installer</id>
                                <phase>install</phase>
                                <configuration>
                                    <scriptFile>installer.nsi</scriptFile>
                                    <outputFile>${project.artifactId}-${project.version}-setup.exe</outputFile>
                                </configuration>
                                <goals>
                                    <goal>generate-headerfile</goal>
                                    <goal>make</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>lwjgl-natives-linux-amd64</id>
            <activation>
                <os>
                    <family>linux</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <lwjgl.natives>natives-linux</lwjgl.natives>
                <jre.os>linux</jre.os>
                <jre.arch>x64</jre.arch>
                <viewer.os>linux</viewer.os> <!-- Note: Probably won't exist unless we start posting Linux builds -->
                <usdz-exporter.os>linux</usdz-exporter.os>
            </properties>
        </profile>
    </profiles>
