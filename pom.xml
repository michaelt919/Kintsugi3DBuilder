<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>Kintsugi3D</groupId>
    <artifactId>Kintsugi3DBuilder</artifactId>
    <version>1.6.0</version>

    <!-- This POM coordinates the project; it does not produce a JAR. -->
    <packaging>pom</packaging>

    <modules>
        <module>app</module>
        <module>builder</module>
        <module>fx</module>
        <module>gl</module>
        <module>optimization/common</module>
        <module>optimization/singlep</module>
        <module>optimization/doublep</module>
        <module>renderexport</module>
        <module>sjm-ply</module>
        <module>util</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>1.13.0</version>
                <executions>
                    <!-- Download latest published build of USDZ exporter -->
                    <!-- Put this one in bin rather than in target so that it's also accessible when running in IDE. -->
                    <execution>
                        <id>download-usdz-exporter</id>
                        <inherited>false</inherited>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>
                                https://github.com/PoctorDepper/usdz-exporter/releases/download/v${usdz-exporter.version}/usdz-exporter-v${usdz-exporter.version}-${usdz-exporter.os}
                            </url>
                            <outputDirectory>
                                ../bin
                            </outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!-- Change permissions for USDZ exporter.  Should be no-op on Windows -->
                    <execution>
                        <id>chmod-usdz-exporter</id>
                        <inherited>false</inherited>
                        <phase>generate-resources</phase>
                        <configuration>
                            <target>
                                <chmod file="${project.basedir}/bin/usdz-exporter-v${usdz-exporter.version}-${usdz-exporter.os}"
                                       perm="755"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <properties>
        <java.version>11</java.version>
        <viewer.version>1.5.2</viewer.version>
        <usdz-exporter.version>1.2.2</usdz-exporter.version>
    </properties>
    <profiles>
        <profile>
            <id>macos-x86_64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <properties>
                <jre.os>mac</jre.os>
                <jre.arch>x64</jre.arch>
                <viewer.os>macos</viewer.os>
                <usdz-exporter.os>macos</usdz-exporter.os>
            </properties>
        </profile>
        <profile>
            <id>macos-arm64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <jre.os>mac</jre.os>
                <jre.arch>aarch64</jre.arch>
                <viewer.os>macos</viewer.os>
                <usdz-exporter.os>macos</usdz-exporter.os>
            </properties>
        </profile>
        <profile>
            <id>windows-amd64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <jre.os>windows</jre.os>
                <jre.arch>x64</jre.arch>
                <viewer.os>windows</viewer.os>
                <usdz-exporter.os>windows.exe</usdz-exporter.os>
            </properties>
        </profile>
        <profile>
            <id>linux-amd64</id>
            <activation>
                <os>
                    <family>linux</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <jre.os>linux</jre.os>
                <jre.arch>x64</jre.arch>
                <viewer.os>linux</viewer.os> <!-- Note: Probably won't exist unless we start posting Linux builds -->
                <usdz-exporter.os>linux</usdz-exporter.os>
            </properties>
        </profile>
    </profiles>
    <dependencies>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.25.5</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.25.5</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>2.25.5</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.13.2</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>
</project>
