<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.*?>
<VBox fx:id = "detailBox"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="kintsugi3d.builder.javafx.controllers.sidebar.ImageDetailsController"
      style = "-fx-background-color: #202020"
      minWidth="0.0"
      VBox.vgrow="ALWAYS"
      maxHeight="-Infinity"
      alignment="TOP_CENTER">
    <padding>
        <Insets left="4" right="4" top="4" bottom="0"/>
    </padding>
    <StackPane fx:id="stackPane"
               alignment="CENTER"
               pickOnBounds="false"
               minHeight="250.0"
               onMousePressed="#startSelection"
               onMouseDragged="#dragSelection"
               onMouseReleased="#endSelection">
        <VBox.margin>
            <Insets left="4" right="4"/>
        </VBox.margin>
        <ImageView fx:id="displayImage"
                   preserveRatio="true"
                   smooth="true"
                   onScroll="#scrolling"
                   StackPane.alignment="CENTER"/>
        <Rectangle fx:id="selectionBox"
                   fill="TRANSPARENT"
                   stroke="GOLD"
                   strokeWidth="2"
                   visible="false"
                   StackPane.alignment="TOP_LEFT" />
    </StackPane>
    <HBox fx:id="buttonRow" spacing = "4.0" minHeight = "0.0" maxHeight="40">
        <padding>
            <Insets top="4" right="0" bottom="4" left="0"/>
        </padding>
    </HBox>
</VBox>
