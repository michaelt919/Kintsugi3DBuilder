<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<VBox alignment="TOP_CENTER" spacing="16.0" styleClass="content-root" fillWidth="false"
      stylesheets="@../../kintsugiStyling.css" xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="kintsugi3d.builder.javafx.controllers.modals.systemsettings.CacheSettingsController">
    <Label fx:id="cacheSizeLabel" styleClass="wireframeBody" text="Cache Size: (calculating...)"/>
    <Button mnemonicParsing="false" fx:id="cleanCacheButton" onAction="#cleanUpCacheButton" styleClass="wireframeBodyLarge" text="Clean Up Cache"/>
    <VBox spacing="8" alignment="CENTER">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <CheckBox styleClass="wireframeBody" fx:id="sizeCheck"/>
            <Label styleClass="wireframeBody"  text="Maximum cache size (GB): "/>
            <TextField styleClass="wireframeBody" fx:id="numGB"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <CheckBox styleClass="wireframeBody" fx:id="recentCheck"/>
            <Label styleClass="wireframeBody" text="Keep only the most recent projects: "/>
            <TextField styleClass="wireframeBody" fx:id="numRecent"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <CheckBox styleClass="wireframeBody" fx:id="timeCheck"/>
            <Label styleClass="wireframeBody" text="Remove after number of days: "/>
            <TextField styleClass="wireframeBody" fx:id="numDays"/>
        </HBox>
    </VBox>
    <TitledPane styleClass="titled-pane, wireframeBody" text="Cache Path">
        <VBox spacing="8.0" styleClass="cache-settings-root">
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
            </padding>
            <Label styleClass="wireframeBody" text="  Current Cache Paths: "/>
            <Label fx:id="previewImageCacheLabel" onMouseClicked="#openDirectory" styleClass="wireframeBody"
                   text="No Path Set">
                <VBox.margin>
                    <Insets left="16.0"/>
                </VBox.margin>
                <cursor>
                    <Cursor fx:constant="HAND"/>
                </cursor>
            </Label>
            <Label fx:id="specularFitCacheLabel" onMouseClicked="#openDirectory" styleClass="wireframeBody"
                   text="No Path Set">
                <VBox.margin>
                    <Insets left="16.0"/>
                </VBox.margin>
                <cursor>
                    <Cursor fx:constant="HAND"/>
                </cursor>
            </Label>
            <Button disable="true" layoutX="10.0" layoutY="10.0" managed="false" mnemonicParsing="false"
                    text="Set Cache Path" visible="false"/>
        </VBox>
    </TitledPane>
    <Button mnemonicParsing="false" onAction="#clearCache" styleClass="wireframeBodyLarge" text="Delete Entire Cache"/>
</VBox>
